<?xml version="1.0" encoding="utf-8"?>
<!--
    Every connection is https: model and language-pack downloads, and the user's
    transcription server, which has a tailnet certificate (e.g. through Caddy or
    `tailscale serve`). A user-entered http:// server URL is refused.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
